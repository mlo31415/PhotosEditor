# Secrets and per-user config -- never commit
Piwigo Credentials.json
PhotosEditor Params.json
PhotosEditorr Params.json

# Python virtual environment
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]

# PyInstaller build artifacts.  PhotosEditor.spec and Build.bat are NOT artifacts --
# the spec carries real build configuration (the sibling folders to bundle, the icon)
# and is tracked, so a rebuilt exe is the same exe on any machine.
build/
dist/
*.exe

# IDE
.idea/

# Documentation kept locally
PhotosEditor.docx

# Runtime logs
*.log

# Runtime / per-user state
PhotosEditor State.json

# Copies of photos kept before they were edited.  They live beside the program
# because that is where its other files live; they are photographs, they can be
# large, and they belong to whoever is running it -- not in the repository.
Photo Backups/
AlbumHierarchy.json
